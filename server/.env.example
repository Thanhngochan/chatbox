# Required: API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low
# Websites allowed to embed the chat box (comma separated). * allows any site, fine on your own computer;
# once online, set it to your site, e.g. https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=15
# Number of document chunks given to Claude per question
RAG_CHUNKS=4
